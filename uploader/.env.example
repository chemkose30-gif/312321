# ── 공통 ─────────────────────────────────────────────
# OAuth 콜백/인스타그램 영상 다운로드에 사용되는 외부 공개 주소.
# 로컬 개발이면 ngrok 등으로 터널을 열고 그 https 주소를 넣으세요.
PUBLIC_BASE_URL=http://localhost:8100
# 저장된 액세스 토큰 암호화 키. 아무 긴 랜덤 문자열.
APP_SECRET=change-me-to-a-long-random-string
# 로그인 비밀번호. 비워두면 잠금이 꺼집니다(로컬 전용).
# 앱의 '계정 관리 → 비밀번호 잠금'에서 브라우저로 정할 수도 있습니다(그 값이 우선).
# 외부에 공개한다면 여기에 미리 채워두세요 — 잠금이 꺼진 채 공개되면 먼저 접속한 사람이 비밀번호를 정할 수 있습니다.
APP_PASSWORD=
# 로그인 유지 기간(일)
SESSION_DAYS=14
PORT=8100

# ── YouTube (Google Cloud Console → OAuth 클라이언트) ──
# 승인된 리디렉션 URI: {PUBLIC_BASE_URL}/api/oauth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── TikTok (developers.tiktok.com → Content Posting API) ──
# Redirect URI: {PUBLIC_BASE_URL}/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Meta (Facebook Page + Instagram 비즈니스 계정 공용) ──
# Redirect URI: {PUBLIC_BASE_URL}/api/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
