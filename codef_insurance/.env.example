# CODEF (codef.io > 키 관리)
CODEF_ENV=demo                # mock(가짜 응답, 화면 시험용) / sandbox / demo / production
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=

# 웹 서비스
PLANNER_PASSWORD=             # 설계사 로그인 비밀번호 (길고 복잡하게)
PLANNER_NAME=홍길동 설계사       # 고객 동의서에 수집 주체로 표시
PUBLIC_BASE_URL=https://example.com   # 고객에게 보낼 링크 주소
DATA_KEY=                     # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONSENT_RETENTION=동의 철회 시까지 (철회 요청 시 지체 없이 파기)
