ANTHROPIC_API_KEY=            # console.anthropic.com 에서 발급
DATA_KEY=                     # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURE_COOKIE=1               # HTTPS 로 운영하면 1, 로컬(http) 테스트면 0
ANALYZER_MOCK=0               # 1 이면 API 호출 없이 샘플 결과 (화면 시험용)
REQUIRE_2FA=1                 # 2단계 인증 필수 (끄지 마세요)
TRUST_PROXY=0                 # nginx 뒤에서 운영하면 1
ALLOWED_IPS=                  # 예: 203.0.113.10,198.51.100.0/24 (비우면 모든 IP 허용)
OTP_ISSUER=보장분석            # OTP 앱에 표시될 이름
