# === 증권 분석 방식 선택 ===
# local  : 서버 안에서 OCR 처리. 데이터가 외부(해외 포함)로 나가지 않음. (기본값, 권장)
#          tesseract-ocr, tesseract-ocr-kor 설치 필요.
# claude : Claude API 사용. 정확도 높지만 증권이 해외 서버로 전송됨 (소속사 규정 확인 필요).
# mock   : 가짜 결과 (화면 시험용).
EXTRACT_BACKEND=local

ANTHROPIC_API_KEY=            # EXTRACT_BACKEND=claude 일 때만 필요. console.anthropic.com 에서 발급
DATA_KEY=                     # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURE_COOKIE=1               # HTTPS 로 운영하면 1, 로컬(http) 테스트면 0
ANALYZER_MOCK=0               # 1 이면 EXTRACT_BACKEND 와 상관없이 샘플 결과 (화면 시험용)
REQUIRE_2FA=1                 # 2단계 인증 필수 (끄지 마세요)
TRUST_PROXY=0                 # nginx 뒤에서 운영하면 1
ALLOWED_IPS=                  # 예: 203.0.113.10,198.51.100.0/24 (비우면 모든 IP 허용)
OTP_ISSUER=보장분석            # OTP 앱에 표시될 이름
