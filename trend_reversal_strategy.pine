//@version=5
strategy(
     title            = "추세전환 전략 v2.0 (CCI+일목+SAR+DMI+Stoch)",
     shorttitle        = "TrendRev",
     overlay           = true,
     initial_capital   = 10000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.04,
     slippage          = 2,
     calc_on_every_tick = false
     )

// ═══════════════════════════════════════════════════════════
//  그룹
// ═══════════════════════════════════════════════════════════
GRP_CCI  = "CCI 설정"
GRP_ICH  = "일목균형표 설정"
GRP_SAR  = "파라볼릭 SAR 설정"
GRP_DMI  = "DMI/ADX 설정"
GRP_ST   = "스토캐스틱 설정"
GRP_SIG  = "신호 강도 설정"
GRP_EXIT = "청산 설정"
GRP_RISK = "리스크 관리"

// ═══════════════════════════════════════════════════════════
//  파라미터
// ═══════════════════════════════════════════════════════════
// CCI
cci_len     = input.int(14, "CCI 기간", minval=5, group=GRP_CCI)
cci_os      = input.int(-100,"CCI 과매도", minval=-200, maxval=-50, group=GRP_CCI)
cci_ob      = input.int(100, "CCI 과매수", minval=50,  maxval=200,  group=GRP_CCI)

// 일목균형표
ich_conv    = input.int(9,  "전환선 기간", minval=5, group=GRP_ICH)
ich_base    = input.int(26, "기준선 기간", minval=10, group=GRP_ICH)
ich_span    = input.int(52, "선행스팬B 기간", minval=20, group=GRP_ICH)
ich_disp    = input.int(26, "구름 이동봉", minval=1, group=GRP_ICH)

// 파라볼릭 SAR
sar_start   = input.float(0.02, "SAR 가속인자 시작", minval=0.001, step=0.001, group=GRP_SAR)
sar_inc     = input.float(0.02, "SAR 가속인자 증분", minval=0.001, step=0.001, group=GRP_SAR)
sar_max     = input.float(0.2,  "SAR 가속인자 최대", minval=0.01,  step=0.01,  group=GRP_SAR)

// DMI/ADX
dmi_len     = input.int(14, "DMI 기간", minval=5, group=GRP_DMI)
adx_thresh  = input.int(20, "ADX 최소 강도 (추세 확인)", minval=10, maxval=50, group=GRP_DMI)

// 스토캐스틱
st_k_len    = input.int(14, "Stoch %K 기간", minval=5, group=GRP_ST)
st_sm_k     = input.int(3,  "Stoch %K 스무딩", minval=1, group=GRP_ST)
st_sm_d     = input.int(3,  "Stoch %D 스무딩", minval=1, group=GRP_ST)
st_os       = input.int(20, "Stoch 과매도", minval=5,  maxval=40, group=GRP_ST)
st_ob       = input.int(80, "Stoch 과매수", minval=60, maxval=95, group=GRP_ST)

// 신호 강도
bull_thresh  = input.int(3, "롱 진입 최소 점수 (5개 중)", minval=2, maxval=5, group=GRP_SIG)
bear_thresh  = input.int(3, "숏 진입 최소 점수 (5개 중)", minval=2, maxval=5, group=GRP_SIG)
exit_thresh  = input.int(2, "청산 최소 점수 (반전 신호)", minval=1, maxval=5, group=GRP_SIG)
use_sar_exit = input.bool(false, "SAR 반전 즉시 청산 (단독)", group=GRP_SIG)
min_hold_bars = input.int(8, "최소 보유 봉수 (재진입 방지)", minval=1, maxval=50, group=GRP_SIG)

// 청산
sl_pct      = input.float(3.0, "손절 (%)", minval=0.5, step=0.1, group=GRP_EXIT)
trail_sl_pct = input.float(2.0,"추적 손절 (%)", minval=0.5, step=0.1, group=GRP_EXIT)
use_trail    = input.bool(true, "추적 손절 사용", group=GRP_EXIT)

// 리스크
leverage_input   = input.int  (3,    "레버리지 배수",  minval=1, maxval=125, group=GRP_RISK)
equity_pct_input = input.float(10.0, "자본 비율 (%)", minval=0.1, maxval=100.0, step=0.1, group=GRP_RISK)

// ═══════════════════════════════════════════════════════════
//  지표 계산
// ═══════════════════════════════════════════════════════════
// CCI
cci_val = ta.cci(close, cci_len)

// 일목균형표
ich_h_conv  = ta.highest(high, ich_conv)
ich_l_conv  = ta.lowest(low,   ich_conv)
ich_conv_line = (ich_h_conv + ich_l_conv) / 2

ich_h_base  = ta.highest(high, ich_base)
ich_l_base  = ta.lowest(low,   ich_base)
ich_base_line = (ich_h_base + ich_l_base) / 2

ich_span_a  = (ich_conv_line + ich_base_line) / 2
ich_h_span  = ta.highest(high, ich_span)
ich_l_span  = ta.lowest(low,   ich_span)
ich_span_b  = (ich_h_span + ich_l_span) / 2

// 현재 구름 (ich_disp 봉 전 선행스팬)
cloud_a = ich_span_a[ich_disp]
cloud_b = ich_span_b[ich_disp]
cloud_top    = math.max(cloud_a, cloud_b)
cloud_bottom = math.min(cloud_a, cloud_b)

above_cloud = close > cloud_top
below_cloud = close < cloud_bottom
in_cloud    = not above_cloud and not below_cloud

// 파라볼릭 SAR
sar_val = ta.sar(sar_start, sar_inc, sar_max)
sar_bull = close > sar_val   // 가격이 SAR 위: 상승
sar_bear = close < sar_val   // 가격이 SAR 아래: 하락

sar_flip_up   = sar_bull and not sar_bull[1]  // SAR이 아래로 플립 (상승 전환)
sar_flip_down = sar_bear and not sar_bear[1]  // SAR이 위로 플립 (하락 전환)

// DMI / ADX
[dmi_plus, dmi_minus, adx_val] = ta.dmi(dmi_len, dmi_len)
dmi_bull = dmi_plus > dmi_minus and adx_val >= adx_thresh
dmi_bear = dmi_minus > dmi_plus and adx_val >= adx_thresh

dmi_cross_up   = ta.crossover(dmi_plus, dmi_minus)
dmi_cross_down = ta.crossunder(dmi_plus, dmi_minus)

// 스토캐스틱
raw_k    = ta.stoch(close, high, low, st_k_len)
k_line   = ta.sma(raw_k, st_sm_k)
d_line   = ta.sma(k_line, st_sm_d)
stoch_cross_up   = ta.crossover(k_line, d_line)  and k_line < 50
stoch_cross_down = ta.crossunder(k_line, d_line) and k_line > 50

// ═══════════════════════════════════════════════════════════
//  점수 계산 — 이번 봉에서 발생한 전환 신호만 카운트
//  (현재 상태 X → 크로스/전환 이벤트 O)
// ═══════════════════════════════════════════════════════════

// CCI: 과매도(-100) 탈출 또는 0선 상향돌파
bull_cci   = ta.crossover(cci_val, cci_os) or ta.crossover(cci_val, 0)
bear_cci   = ta.crossunder(cci_val, cci_ob) or ta.crossunder(cci_val, 0)

// 일목: 가격이 구름 상단을 위로 돌파 / 전환선이 기준선 상향돌파
bull_ich   = ta.crossover(close, cloud_top)
           or (ta.crossover(ich_conv_line, ich_base_line) and not below_cloud)
bear_ich   = ta.crossunder(close, cloud_bottom)
           or (ta.crossunder(ich_conv_line, ich_base_line) and not above_cloud)

// SAR: 이번 봉에서 방향 전환
bull_sar   = sar_flip_up
bear_sar   = sar_flip_down

// DMI: DI+ / DI- 교차 (ADX 강도 확인)
bull_dmi   = dmi_cross_up   and adx_val >= adx_thresh
bear_dmi   = dmi_cross_down and adx_val >= adx_thresh

// 스토캐스틱: 과매도/과매수 구간에서의 크로스만 유효
bull_stoch = stoch_cross_up   and k_line < 50
bear_stoch = stoch_cross_down and k_line > 50

bull_score = (bull_cci   ? 1 : 0)
           + (bull_ich   ? 1 : 0)
           + (bull_sar   ? 1 : 0)
           + (bull_dmi   ? 1 : 0)
           + (bull_stoch ? 1 : 0)

bear_score = (bear_cci   ? 1 : 0)
           + (bear_ich   ? 1 : 0)
           + (bear_sar   ? 1 : 0)
           + (bear_dmi   ? 1 : 0)
           + (bear_stoch ? 1 : 0)

// ═══════════════════════════════════════════════════════════
//  진입 조건 (최소 보유 봉수 쿨다운 포함)
// ═══════════════════════════════════════════════════════════
var int last_exit_bar = 0
cooldown_ok = (bar_index - last_exit_bar) >= min_hold_bars

long_entry  = bull_score >= bull_thresh and strategy.position_size == 0 and cooldown_ok
short_entry = bear_score >= bear_thresh and strategy.position_size == 0 and cooldown_ok

// ═══════════════════════════════════════════════════════════
//  수량 계산
// ═══════════════════════════════════════════════════════════
qty_val = strategy.equity * (equity_pct_input / 100.0) * leverage_input / close

// ═══════════════════════════════════════════════════════════
//  진입
// ═══════════════════════════════════════════════════════════
if long_entry
    strategy.entry("Long", strategy.long, qty=qty_val,
         comment="↑" + str.tostring(bull_score) + "/5")

if short_entry
    strategy.entry("Short", strategy.short, qty=qty_val,
         comment="↓" + str.tostring(bear_score) + "/5")

// ═══════════════════════════════════════════════════════════
//  청산: 다음 추세전환 신호
// ═══════════════════════════════════════════════════════════
if strategy.position_size > 0
    avg = strategy.position_avg_price
    sl_price = avg * (1 - sl_pct / 100)

    // 다음 하락 전환 신호 (반전 청산)
    rev_exit_long = bear_score >= exit_thresh or (use_sar_exit and sar_flip_down)

    if rev_exit_long
        strategy.close("Long", comment="전환↓")
        last_exit_bar := bar_index
    else
        if use_trail
            strategy.exit("Long-SL", from_entry="Long",
                 trail_price=avg * (1 + trail_sl_pct / 100),
                 trail_offset=avg * trail_sl_pct / 100 / syminfo.mintick,
                 stop=sl_price, comment="추적SL")
        else
            strategy.exit("Long-SL", from_entry="Long",
                 stop=sl_price, comment="SL")

if strategy.position_size < 0
    avg = strategy.position_avg_price
    sl_price = avg * (1 + sl_pct / 100)

    rev_exit_short = bull_score >= exit_thresh or (use_sar_exit and sar_flip_up)

    if rev_exit_short
        strategy.close("Short", comment="전환↑")
        last_exit_bar := bar_index
    else
        if use_trail
            strategy.exit("Short-SL", from_entry="Short",
                 trail_price=avg * (1 - trail_sl_pct / 100),
                 trail_offset=avg * trail_sl_pct / 100 / syminfo.mintick,
                 stop=sl_price, comment="추적SL")
        else
            strategy.exit("Short-SL", from_entry="Short",
                 stop=sl_price, comment="SL")

// 손절 청산 시에도 쿨다운 적용
if strategy.position_size == 0 and strategy.position_size[1] != 0
    last_exit_bar := bar_index

// ═══════════════════════════════════════════════════════════
//  시각화
// ═══════════════════════════════════════════════════════════
// 파라볼릭 SAR
plot(sar_val, "SAR", style=plot.style_circles,
     color=sar_bull ? color.new(color.lime,0) : color.new(color.red,0),
     linewidth=1)

// 일목균형표 구름
a1 = plot(cloud_top,    "구름 상단", color=color.new(color.red,   80), display=display.none)
a2 = plot(cloud_bottom, "구름 하단", color=color.new(color.green, 80), display=display.none)
fill(a1, a2,
     color=cloud_top > cloud_bottom ? color.new(color.red,85) : color.new(color.lime,85))

plot(ich_conv_line, "전환선", color=color.new(color.blue,   10), linewidth=1)
plot(ich_base_line, "기준선", color=color.new(color.orange, 10), linewidth=1)

// 진입 화살표
plotshape(long_entry,  title="롱 진입", location=location.belowbar,
          style=shape.triangleup,   size=size.normal, color=color.lime,
          text="L")
plotshape(short_entry, title="숏 진입", location=location.abovebar,
          style=shape.triangledown, size=size.normal, color=color.red,
          text="S")

// 포지션 배경
bgcolor(strategy.position_size > 0 ? color.new(color.lime, 93)
      : strategy.position_size < 0 ? color.new(color.red,  93)
      : na)

// DMI 상태 표시 (배경)
bgcolor(dmi_cross_up   ? color.new(color.aqua, 85)
      : dmi_cross_down ? color.new(color.purple,  85) : na)

// 정보 테이블
var table info = table.new(position.top_right, 2, 7, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "추세전환 전략", bgcolor=color.new(color.navy,80), text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, "", bgcolor=color.new(color.navy,80))
    table.cell(info, 0, 1, "CCI", text_size=size.tiny)
    table.cell(info, 1, 1, cci_val >= 0 ? "▲ " + str.tostring(math.round(cci_val)) : "▼ " + str.tostring(math.round(cci_val)),
               bgcolor=cci_val>0?color.new(color.lime,70):color.new(color.red,70), text_size=size.tiny)
    table.cell(info, 0, 2, "일목 구름", text_size=size.tiny)
    table.cell(info, 1, 2, above_cloud ? "구름 위 ▲" : below_cloud ? "구름 아래 ▼" : "구름 안",
               bgcolor=above_cloud?color.new(color.lime,70):below_cloud?color.new(color.red,70):color.new(color.gray,70), text_size=size.tiny)
    table.cell(info, 0, 3, "SAR", text_size=size.tiny)
    table.cell(info, 1, 3, sar_bull ? "상승 ▲" : "하락 ▼",
               bgcolor=sar_bull?color.new(color.lime,70):color.new(color.red,70), text_size=size.tiny)
    table.cell(info, 0, 4, "DMI(ADX=" + str.tostring(math.round(adx_val)) + ")", text_size=size.tiny)
    table.cell(info, 1, 4, dmi_bull ? "DI+우세 ▲" : dmi_bear ? "DI-우세 ▼" : "중립",
               bgcolor=dmi_bull?color.new(color.lime,70):dmi_bear?color.new(color.red,70):color.new(color.gray,70), text_size=size.tiny)
    table.cell(info, 0, 5, "Stoch", text_size=size.tiny)
    table.cell(info, 1, 5, str.tostring(math.round(k_line)) + " / " + str.tostring(math.round(d_line)),
               bgcolor=k_line>d_line?color.new(color.lime,70):color.new(color.red,70), text_size=size.tiny)
    table.cell(info, 0, 6, "점수", text_size=size.small)
    table.cell(info, 1, 6, "↑" + str.tostring(bull_score) + "  ↓" + str.tostring(bear_score) + " /5",
               bgcolor=bull_score>=bull_thresh?color.new(color.lime,60):bear_score>=bear_thresh?color.new(color.red,60):color.new(color.gray,80), text_size=size.small)
