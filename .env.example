# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 깃에 올라가지 않습니다)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 토큰 요청 방식: body(폼 본문에 키) 또는 basic(HTTP Basic). 401 이 나면 바꿔 보세요.
TOSS_AUTH_STYLE=body

# 공개 자료끼리 경로가 달라 검증되지 않은 기본값입니다. 공식 명세를 보고 맞추세요.
# https://openapi.tossinvest.com/openapi-docs/latest/openapi.json
TOSS_TOKEN_PATH=/oauth2/token
TOSS_CANDLES_PATH=/api/v1/candles
