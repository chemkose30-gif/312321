//@version=5
strategy("MFI + Supertrend 15분봉 전략", shorttitle="MFI-ST-15M", overlay=true,
         initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=3,
         commission_type=strategy.commission.percent, commission_value=0.04, slippage=1)

// ── 파라미터 ────────────────────────────────────────────────────
st_period   = input.int(14,   "Supertrend ATR 기간",   minval=5)
st_mult     = input.float(3.5,"Supertrend ATR 배수",   minval=1.0, step=0.1)
mfi_period  = input.int(20,   "MFI 기간",              minval=5)
mfi_ob      = input.int(80,   "MFI 과매수",            minval=60, maxval=95)
mfi_os      = input.int(20,   "MFI 과매도",            minval=5,  maxval=40)
stop_pct    = input.float(2.5,"손절 (%)",              minval=0.1, step=0.1) / 100
use_mfi_filter = input.bool(true, "MFI 필터 사용 (꺼두면 Supertrend 단독)")

// ── Supertrend ───────────────────────────────────────────────────
atr_val = ta.atr(st_period)
hl2_src  = hl2

upper_basic = hl2_src + st_mult * atr_val
lower_basic = hl2_src - st_mult * atr_val

var float final_upper = na
var float final_lower = na
var int   st_dir      = 0    // 1 = 상승추세, -1 = 하락추세

final_upper := na(final_upper[1]) ? upper_basic :
               upper_basic < final_upper[1] or close[1] > final_upper[1] ? upper_basic : final_upper[1]
final_lower := na(final_lower[1]) ? lower_basic :
               lower_basic > final_lower[1] or close[1] < final_lower[1] ? lower_basic : final_lower[1]

st_dir := na(st_dir[1]) ? 1 :
          st_dir[1] == -1 and close > final_upper ? 1 :
          st_dir[1] ==  1 and close < final_lower ? -1 : st_dir[1]

st_line = st_dir == 1 ? final_lower : final_upper
st_bull = st_dir == 1   // 상승추세
st_bear = st_dir == -1  // 하락추세

// Supertrend 방향 전환
st_flip_up   = st_bull and not st_bull[1]   // 하락→상승 전환
st_flip_down = st_bear and not st_bear[1]   // 상승→하락 전환

// ── MFI ─────────────────────────────────────────────────────────
typical   = hlc3
raw_mfi   = volume * (2 * typical - high - low)   // 간략화: 양수=매수압력, 음수=매도압력
mfi_pos   = math.max(raw_mfi, 0)
mfi_neg   = math.max(-raw_mfi, 0)
mfi_ratio = ta.sma(mfi_pos, mfi_period) / (ta.sma(mfi_neg, mfi_period) + 1e-10)
mfi       = 100 - 100 / (1 + mfi_ratio)

mfi_bull = mfi < mfi_os   // 과매도 (롱 유리)
mfi_bear = mfi > mfi_ob   // 과매수 (숏 유리)

// ── 진입 조건 ────────────────────────────────────────────────────
// 롱: Supertrend 상승 전환 + (MFI 과매도 또는 필터 OFF)
// 숏: Supertrend 하락 전환 + (MFI 과매수 또는 필터 OFF)

mfi_long_ok  = use_mfi_filter ? mfi_bull : true
mfi_short_ok = use_mfi_filter ? mfi_bear : true

long_entry  = st_flip_up   and mfi_long_ok  and strategy.position_size == 0
short_entry = st_flip_down and mfi_short_ok and strategy.position_size == 0

// ── 청산 조건 ────────────────────────────────────────────────────
// 기본: 반대 방향 Supertrend 전환 시 청산
long_exit  = st_flip_down and strategy.position_size > 0
short_exit = st_flip_up   and strategy.position_size < 0

// ── 전략 실행 ────────────────────────────────────────────────────
if long_entry
    strategy.entry("Long", strategy.long, comment="↑MFI-ST")

if short_entry
    strategy.entry("Short", strategy.short, comment="↓MFI-ST")

if long_exit
    strategy.close("Long", comment="ST반전")

if short_exit
    strategy.close("Short", comment="ST반전")

// 손절
long_stop  = strategy.position_avg_price * (1 - stop_pct)
short_stop = strategy.position_avg_price * (1 + stop_pct)

if strategy.position_size > 0
    strategy.exit("Long-SL",  from_entry="Long",  stop=long_stop,  comment="손절")

if strategy.position_size < 0
    strategy.exit("Short-SL", from_entry="Short", stop=short_stop, comment="손절")

// ── 시각화 ──────────────────────────────────────────────────────
// Supertrend 라인
st_color = st_bull ? color.new(color.green, 0) : color.new(color.red, 0)
plot(st_line, "Supertrend", color=st_color, linewidth=2)

// MFI 과매도/과매수 배경
bgcolor(mfi_bull ? color.new(color.lime,  92) :
        mfi_bear ? color.new(color.red,   92) : na, title="MFI 상태")

// 포지션 배경
bgcolor(strategy.position_size > 0 ? color.new(color.blue, 90) :
        strategy.position_size < 0 ? color.new(color.orange, 90) : na)

// 진입 신호
plotshape(long_entry,  title="롱 진입", location=location.belowbar,
          style=shape.triangleup,   size=size.normal, color=color.lime, text="▲")
plotshape(short_entry, title="숏 진입", location=location.abovebar,
          style=shape.triangledown, size=size.normal, color=color.red,  text="▼")
