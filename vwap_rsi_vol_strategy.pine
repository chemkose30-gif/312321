//@version=5
strategy(
     title            = "VWAP + RSI + 거래량 전략 v1.0",
     shorttitle        = "VWAP-RSI-Vol",
     overlay           = true,
     initial_capital   = 10000,
     default_qty_type  = strategy.cash,
     default_qty_value = 100,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.04,
     slippage          = 2,
     calc_on_every_tick = false
     )

// ═══════════════════════════════════════════════════════════
//  그룹 레이블
// ═══════════════════════════════════════════════════════════
GRP_VWAP = "VWAP 설정"
GRP_RSI  = "RSI 설정"
GRP_VOL  = "거래량 설정"
GRP_EXIT = "청산 설정"
GRP_RISK = "리스크 관리"

// ═══════════════════════════════════════════════════════════
//  파라미터
// ═══════════════════════════════════════════════════════════
// VWAP
vwap_anchor  = input.string("Session", "VWAP 앵커",
                 options=["Session","Week","Month"], group=GRP_VWAP)
use_vwap_band = input.bool(true, "VWAP 밴드 사용 (±1σ)", group=GRP_VWAP)
vwap_band_mult = input.float(1.0, "VWAP 밴드 배수", minval=0.5, step=0.1, group=GRP_VWAP)

// RSI
rsi_len      = input.int(14, "RSI 기간", minval=2, group=GRP_RSI)
rsi_long_min = input.int(50, "롱 RSI 최소", minval=30, maxval=70, group=GRP_RSI)
rsi_short_max= input.int(50, "숏 RSI 최대", minval=30, maxval=70, group=GRP_RSI)
rsi_os       = input.int(40, "RSI 과매도 (진입 기준)",  minval=20, maxval=50, group=GRP_RSI)
rsi_ob       = input.int(60, "RSI 과매수 (진입 기준)",  minval=50, maxval=80, group=GRP_RSI)

// 거래량
vol_ma_len   = input.int(20,  "거래량 이평 기간", minval=5, group=GRP_VOL)
vol_mult     = input.float(1.2,"거래량 배수 (현재 >= N×MA)", minval=0.5, step=0.1, group=GRP_VOL)

// 청산
sl_pct       = input.float(2.0, "손절 (%)",   minval=0.1, step=0.1, group=GRP_EXIT)
tp1_pct      = input.float(1.5, "1차 TP (%)", minval=0.1, step=0.1, group=GRP_EXIT)
tp2_pct      = input.float(3.0, "2차 TP (%)", minval=0.2, step=0.1, group=GRP_EXIT)
tp1_qty      = input.int(50,    "1차 TP 청산 비율 (%)", minval=1, maxval=99, group=GRP_EXIT)
use_vwap_exit = input.bool(true,"VWAP 이탈 시 청산", group=GRP_EXIT)

// 리스크
leverage_input   = input.int  (3,    "레버리지 배수",  minval=1, maxval=125, group=GRP_RISK)
equity_pct_input = input.float(10.0, "자본 비율 (%)", minval=0.1, maxval=100.0, step=0.1, group=GRP_RISK)

// ═══════════════════════════════════════════════════════════
//  지표 계산
// ═══════════════════════════════════════════════════════════
// VWAP (앵커 설정)
anchor_type = vwap_anchor == "Week" ? timeframe.change("1W") :
              vwap_anchor == "Month" ? timeframe.change("1M") :
              timeframe.change("D")

var float cum_pv  = 0.0
var float cum_vol = 0.0
var float cum_pv2 = 0.0

if anchor_type
    cum_pv  := 0.0
    cum_vol := 0.0
    cum_pv2 := 0.0

typical = (high + low + close) / 3
cum_pv  += typical * volume
cum_vol += volume
cum_pv2 += typical * typical * volume

vwap_val  = cum_pv / cum_vol
vwap_var  = cum_pv2 / cum_vol - vwap_val * vwap_val
vwap_std  = vwap_var > 0 ? math.sqrt(vwap_var) : 0.0
vwap_upper = vwap_val + vwap_band_mult * vwap_std
vwap_lower = vwap_val - vwap_band_mult * vwap_std

// RSI
rsi_val  = ta.rsi(close, rsi_len)

// 거래량
vol_ma   = ta.sma(volume, vol_ma_len)
vol_ok   = volume >= vol_ma * vol_mult

// 수량 계산
qty_val  = strategy.equity * (equity_pct_input / 100.0) * leverage_input / close

// ═══════════════════════════════════════════════════════════
//  진입 조건
// ═══════════════════════════════════════════════════════════
// 롱: 종가 > VWAP + RSI가 rsi_long_min 이상 + 거래량 급증
// (가격이 VWAP 위에서 모멘텀이 살아있을 때 추세 추종)
long_vwap   = close > vwap_val
long_rsi    = rsi_val >= rsi_long_min
long_cross  = ta.crossover(close, vwap_val) or
              (close > vwap_val and ta.crossover(rsi_val, rsi_os))

long_entry  = long_cross and long_rsi and vol_ok and strategy.position_size == 0

// 숏: 종가 < VWAP + RSI가 rsi_short_max 이하 + 거래량 급증
short_vwap  = close < vwap_val
short_rsi   = rsi_val <= rsi_short_max
short_cross = ta.crossunder(close, vwap_val) or
              (close < vwap_val and ta.crossunder(rsi_val, rsi_ob))

short_entry = short_cross and short_rsi and vol_ok and strategy.position_size == 0

// ═══════════════════════════════════════════════════════════
//  진입
// ═══════════════════════════════════════════════════════════
if long_entry
    strategy.entry("Long", strategy.long, qty=qty_val, comment="VWAP↑RSI↑Vol")

if short_entry
    strategy.entry("Short", strategy.short, qty=qty_val, comment="VWAP↓RSI↓Vol")

// ═══════════════════════════════════════════════════════════
//  청산
// ═══════════════════════════════════════════════════════════
if strategy.position_size > 0
    long_sl   = strategy.position_avg_price * (1 - sl_pct  / 100)
    long_tp1  = strategy.position_avg_price * (1 + tp1_pct / 100)
    long_tp2  = strategy.position_avg_price * (1 + tp2_pct / 100)

    // VWAP 하향 이탈 시 즉시 청산
    if use_vwap_exit and close < vwap_val
        strategy.close("Long", comment="VWAP이탈")
    else
        strategy.exit("Long-TP1", from_entry="Long",
             qty_percent=tp1_qty, limit=long_tp1, stop=long_sl, comment="TP1")
        strategy.exit("Long-TP2", from_entry="Long",
             qty_percent=100, limit=long_tp2, stop=long_sl, comment="TP2")

if strategy.position_size < 0
    short_sl  = strategy.position_avg_price * (1 + sl_pct  / 100)
    short_tp1 = strategy.position_avg_price * (1 - tp1_pct / 100)
    short_tp2 = strategy.position_avg_price * (1 - tp2_pct / 100)

    if use_vwap_exit and close > vwap_val
        strategy.close("Short", comment="VWAP이탈")
    else
        strategy.exit("Short-TP1", from_entry="Short",
             qty_percent=tp1_qty, limit=short_tp1, stop=short_sl, comment="TP1")
        strategy.exit("Short-TP2", from_entry="Short",
             qty_percent=100, limit=short_tp2, stop=short_sl, comment="TP2")

// ═══════════════════════════════════════════════════════════
//  시각화
// ═══════════════════════════════════════════════════════════
plot(vwap_val,   "VWAP",       color=color.new(color.yellow, 0),  linewidth=2)
plot(use_vwap_band ? vwap_upper : na, "VWAP+1σ", color=color.new(color.red,   40), linewidth=1)
plot(use_vwap_band ? vwap_lower : na, "VWAP-1σ", color=color.new(color.green, 40), linewidth=1)

plotshape(long_entry,  title="롱 진입", location=location.belowbar,
          style=shape.triangleup,   size=size.normal, color=color.lime, text="L")
plotshape(short_entry, title="숏 진입", location=location.abovebar,
          style=shape.triangledown, size=size.normal, color=color.red,  text="S")

bgcolor(strategy.position_size > 0 ? color.new(color.lime, 92)
      : strategy.position_size < 0 ? color.new(color.red,  92)
      : na)

// RSI 배경 표시 (과매수/과매도)
bgcolor(rsi_val >= 70 ? color.new(color.red,  97)
      : rsi_val <= 30 ? color.new(color.lime, 97)
      : na)

// 정보 테이블
var table info = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "VWAP+RSI+Vol 설정", bgcolor=color.new(color.navy,80), text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, "", bgcolor=color.new(color.navy,80))
    table.cell(info, 0, 1, "VWAP 앵커", text_size=size.small)
    table.cell(info, 1, 1, vwap_anchor, text_size=size.small)
    table.cell(info, 0, 2, "RSI 기간/기준", text_size=size.small)
    table.cell(info, 1, 2, str.tostring(rsi_len) + " / >" + str.tostring(rsi_long_min), text_size=size.small)
    table.cell(info, 0, 3, "레버리지/자본%", text_size=size.small)
    table.cell(info, 1, 3, str.tostring(leverage_input) + "x / " + str.tostring(equity_pct_input) + "%", text_size=size.small)
    table.cell(info, 0, 4, "SL / TP1 / TP2", text_size=size.small)
    table.cell(info, 1, 4, str.tostring(sl_pct) + "% / " + str.tostring(tp1_pct) + "% / " + str.tostring(tp2_pct) + "%", text_size=size.small)
