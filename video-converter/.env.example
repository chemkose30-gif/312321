# 직원들과 공유할 비밀번호 (비워두면 누구나 접속 가능 - 서버에서는 반드시 설정하세요)
APP_PASSWORD=change-me

# 업로드 최대 크기 (MB)
MAX_UPLOAD_MB=4096

# 동시에 처리할 작업 수 (CPU 4코어면 2, 8코어면 3~4 추천)
MAX_CONCURRENT=2

# GPU가 있어도 끄고 싶으면 1
DISABLE_GPU=0

# 접속 주소. 도메인이 없으면 setup.sh가 서버IP.sslip.io 형태로 자동 설정해요
# (예: 1.2.3.4 → 1-2-3-4.sslip.io). 도메인을 샀다면 그 도메인을 넣으세요.
DOMAIN=

# (선택) 유튜브 다운로드를 다른 인터넷 회선으로 우회할 프록시
# 예: http://사용자:비번@프록시주소:포트  또는  socks5://100.x.x.x:1080
YTDLP_PROXY=
