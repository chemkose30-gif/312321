//@version=5
// ⚠️ 경고: 마틴게일 전략은 SL 없이 강한 단방향 추세 발생 시 계좌 전액 손실 위험
// 반드시 데모 계좌에서 충분히 테스트 후 실거래 적용할 것

strategy(
     title            = "Road To Billion - BB 마틴게일",
     shorttitle        = "RTB-Mart",
     overlay           = true,
     initial_capital   = 10000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.04,
     slippage          = 2,
     calc_on_every_tick = false
     )

// ═══════════════════════════════════════════════════════════
//  그룹 레이블
// ═══════════════════════════════════════════════════════════
GRP_BB   = "볼린저밴드 설정"
GRP_MART = "마틴게일 설정"
GRP_EXIT = "청산 설정"

// ═══════════════════════════════════════════════════════════
//  파라미터
// ═══════════════════════════════════════════════════════════
bb_period  = input.int  (20,  "BB 기간",    minval=5,  group=GRP_BB)
bb_std_val = input.float(2.0, "BB 배수",    minval=0.5, step=0.1, group=GRP_BB)

base_pct   = input.float(2.0, "기본 진입 자본 (%)",   minval=0.1, step=0.1, group=GRP_MART)
mart_mult  = input.float(2.0, "마틴게일 배수",         minval=1.1, step=0.1, group=GRP_MART)
max_layers = input.int  (5,   "최대 물타기 횟수",      minval=1,   maxval=10, group=GRP_MART)
grid_pct   = input.float(1.5, "물타기 간격 (%)",       minval=0.1, step=0.1, group=GRP_MART)

tp_pct     = input.float(1.0, "TP (%,  평단가 기준)", minval=0.1, step=0.1, group=GRP_EXIT)
// SL: 원본 그대로 없음

// ═══════════════════════════════════════════════════════════
//  지표 계산
// ═══════════════════════════════════════════════════════════
[bb_mid, bb_upper, bb_lower] = ta.bb(close, bb_period, bb_std_val)

// ═══════════════════════════════════════════════════════════
//  상태 변수
// ═══════════════════════════════════════════════════════════
var int   long_layers      = 0
var float long_last_add    = na
var int   short_layers     = 0
var float short_last_add   = na

base_qty = strategy.equity * (base_pct / 100.0) / close

// ═══════════════════════════════════════════════════════════
//  롱 로직
// ═══════════════════════════════════════════════════════════
// 최초 진입: 종가가 BB 하단 이하로 내려왔을 때
long_init = close <= bb_lower and strategy.position_size == 0

// 물타기: 마지막 진입가 대비 grid_pct% 추가 하락 + 최대 레이어 미만
long_add  = (strategy.position_size > 0 and
             long_layers < max_layers   and
             not na(long_last_add)      and
             close <= long_last_add * (1 - grid_pct / 100))

// TP: 평균단가 + tp_pct% 도달
long_tp   = (strategy.position_size > 0 and
             close >= strategy.position_avg_price * (1 + tp_pct / 100))

if long_init
    strategy.entry("Long", strategy.long, qty=base_qty, comment="롱1")
    long_layers   := 1
    long_last_add := close
    short_layers  := 0
    short_last_add := na

if long_add
    add_qty = base_qty * math.pow(mart_mult, long_layers)
    strategy.entry("Long", strategy.long, qty=add_qty,
                   comment="물타기" + str.tostring(long_layers + 1))
    long_layers   += 1
    long_last_add := close

if long_tp
    strategy.close_all(comment="TP")
    long_layers   := 0
    long_last_add := na

// ═══════════════════════════════════════════════════════════
//  숏 로직
// ═══════════════════════════════════════════════════════════
short_init = close >= bb_upper and strategy.position_size == 0

short_add  = (strategy.position_size < 0 and
              short_layers < max_layers   and
              not na(short_last_add)      and
              close >= short_last_add * (1 + grid_pct / 100))

short_tp   = (strategy.position_size < 0 and
              close <= strategy.position_avg_price * (1 - tp_pct / 100))

if short_init
    strategy.entry("Short", strategy.short, qty=base_qty, comment="숏1")
    short_layers   := 1
    short_last_add := close
    long_layers    := 0
    long_last_add  := na

if short_add
    add_qty = base_qty * math.pow(mart_mult, short_layers)
    strategy.entry("Short", strategy.short, qty=add_qty,
                   comment="물타기" + str.tostring(short_layers + 1))
    short_layers   += 1
    short_last_add := close

if short_tp
    strategy.close_all(comment="TP")
    short_layers   := 0
    short_last_add := na

// ═══════════════════════════════════════════════════════════
//  시각화
// ═══════════════════════════════════════════════════════════
p_upper = plot(bb_upper, "BB 상단", color=color.new(color.white, 30), linewidth=1)
p_mid   = plot(bb_mid,   "BB 중앙", color=color.new(color.red,   30), linewidth=1)
p_lower = plot(bb_lower, "BB 하단", color=color.new(color.white, 30), linewidth=1)
fill(p_upper, p_lower, color=color.new(color.gray, 90))

// 물타기 레벨 표시
bgcolor(long_layers  >= max_layers ? color.new(color.orange, 85) :
        short_layers >= max_layers ? color.new(color.orange, 85) : na)

bgcolor(strategy.position_size > 0 ? color.new(color.lime, 93)
      : strategy.position_size < 0 ? color.new(color.red,  93) : na)

plotshape(long_init,  title="롱 진입",  location=location.belowbar,
          style=shape.triangleup,   size=size.small, color=color.lime)
plotshape(short_init, title="숏 진입",  location=location.abovebar,
          style=shape.triangledown, size=size.small, color=color.red)
plotshape(long_add or short_add, title="물타기",
          location=location.belowbar, style=shape.circle,
          size=size.tiny, color=color.orange)

// ═══════════════════════════════════════════════════════════
//  정보 테이블
// ═══════════════════════════════════════════════════════════
var table info = table.new(position.top_right, 2, 6, border_width=1)
if barstate.islast
    cur_layer = long_layers > 0 ? long_layers : short_layers
    table.cell(info, 0, 0, "RTB 마틴게일",
         bgcolor=color.new(color.maroon, 60), text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, "⚠️ SL 없음",
         bgcolor=color.new(color.maroon, 60), text_color=color.yellow, text_size=size.small)
    table.cell(info, 0, 1, "BB 기간/배수",  text_size=size.small)
    table.cell(info, 1, 1, str.tostring(bb_period) + " / " + str.tostring(bb_std_val), text_size=size.small)
    table.cell(info, 0, 2, "마틴게일 배수", text_size=size.small)
    table.cell(info, 1, 2, str.tostring(mart_mult) + "x", text_size=size.small)
    table.cell(info, 0, 3, "물타기 간격/최대", text_size=size.small)
    table.cell(info, 1, 3, str.tostring(grid_pct) + "% / " + str.tostring(max_layers) + "단", text_size=size.small)
    table.cell(info, 0, 4, "TP (%)",  text_size=size.small)
    table.cell(info, 1, 4, str.tostring(tp_pct) + "%", text_size=size.small)
    table.cell(info, 0, 5, "현재 레이어", text_size=size.small)
    table.cell(info, 1, 5, str.tostring(cur_layer) + " / " + str.tostring(max_layers),
         bgcolor= cur_layer >= max_layers ? color.new(color.orange, 60) : color.new(color.navy, 80),
         text_size=size.small)
