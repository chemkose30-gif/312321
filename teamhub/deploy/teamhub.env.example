# TeamHub 서버 설정 - 수정 후: sudo systemctl restart teamhub

# 직원들이 접속하는 주소 (메일 버튼 링크에 사용)
TEAMHUB_BASE_URL=https://teamhub.example.com

# 최초 관리자 비밀번호 (DB 가 처음 만들어질 때만 사용)
TEAMHUB_ADMIN_PASSWORD=admin1234

# Microsoft 365 메일 발송 (README "Outlook 메일 연동" 참고)
TEAMHUB_MS_TENANT_ID=
TEAMHUB_MS_CLIENT_ID=
TEAMHUB_MS_CLIENT_SECRET=
TEAMHUB_MAIL_FROM=

# 리마인더 발송 시각 (서버 시간 기준, 0~23)
TEAMHUB_REMINDER_HOUR=9
