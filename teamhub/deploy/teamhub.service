[Unit]
Description=TeamHub (사내 캘린더 & 업무지시)
After=network-online.target
Wants=network-online.target

[Service]
User=teamhub
Group=teamhub
WorkingDirectory=/opt/teamhub
Environment=TZ=Asia/Seoul
Environment=HOST=127.0.0.1
Environment=PORT=8100
Environment=TEAMHUB_DB=/var/lib/teamhub/teamhub.db
EnvironmentFile=/etc/teamhub.env
ExecStart=/opt/teamhub/venv/bin/python app.py
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
